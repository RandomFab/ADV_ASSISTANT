# ====================================
# PostgreSQL (Docker)
# ====================================
# POSTGRES_HOST should be 'postgres' in Docker, 'localhost' for local dev
POSTGRES_DB=steelbot
POSTGRES_USER=steelbot_user
POSTGRES_PASSWORD=steelbot_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ====================================
# Mistral AI — Large Language Model
# ====================================
# Get your API key at: https://console.mistral.ai/api-tokens/
MISTRAL_API_KEY=your_mistral_api_key_here

# ====================================
# GitHub — for monitoring & alerting
# ====================================
# Generate a personal access token at: https://github.com/settings/tokens
# Required scopes: repo (for issues), read:user
GITHUB_TOKEN=your_github_pat_here
GITHUB_REPO=owner/repo-name

# ====================================
# Application URLs
# ====================================
# Used by Streamlit to call FastAPI
# In Docker: http://fastapi:8000
# Local dev: http://127.0.0.1:8001
API_URL=http://fastapi:8001
